{
  "name": "homepro-ai-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @homepro/api",
    "test": "npm run typecheck && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scenarios": "npm run scenarios -w @homepro/api --",
    "eval:llm": "npm run eval:llm -w @homepro/api"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
