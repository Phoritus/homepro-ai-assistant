# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# HTTP port and the public URL used in product / checkout links (must be HTTPS and public for live LINE).
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Groq LLM (free tier: https://console.groq.com/keys). Leave empty to run on keyword rules only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=8000

# LINE Messaging API (LINE Developers console > your channel).
# Leave LINE_CHANNEL_SECRET empty to disable the webhook.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# "stub" captures replies instead of calling LINE (synthetic-event testing). Anything else = live.
LINE_MODE=stub

# Idle sessions are forgotten after this many minutes.
SESSION_TTL_MINUTES=30
